---
import Layout from "../components/global.astro";
import Nav from "../components/nav.astro";

const currentYear = new Date().getFullYear();

const memberFiles = import.meta.glob("../data/members/members-*.json", {
    eager: true,
});

const availableYears = Object.keys(memberFiles)
    .map((path) => {
        const match = path.match(/members-(\d{4})\.json$/);
        return match ? Number(match[1]) : null;
    })
    .filter((year): year is number => year !== null)
    .sort((a, b) => b - a);

const targetYear = availableYears.includes(currentYear)
    ? currentYear
    : availableYears[0];

const targetFileKey = Object.keys(memberFiles).find((path) =>
    path.endsWith(`members-${targetYear}.json`),
);

const rawData: any = targetFileKey ? memberFiles[targetFileKey] : [];
const activeMembers: any[] = rawData.default || rawData || [];

const ucwords = (str: string = "") => {
    if (!str) return "";
    return str
        .toLowerCase()
        .split(" ")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
};

const execPositions = ["adviser", "president", "vice president"];
const execMembers = activeMembers.filter((m) =>
    execPositions.includes(m.position?.trim().toLowerCase() ?? ""),
);

const excludedOther = [
    "member",
    "president",
    "vice president",
    "media lead",
    "creatives lead",
    "adviser",
];
const otherOfficers = activeMembers.filter(
    (m) => !excludedOther.includes(m.position?.trim().toLowerCase() ?? ""),
);

const leadPositions = ["media lead", "creatives lead"];
const leads = activeMembers.filter((m) =>
    leadPositions.includes(m.position?.trim().toLowerCase() ?? ""),
);

const regularMembers = [...activeMembers]
    .filter((m) => (m.position?.trim().toLowerCase() ?? "") === "member")
    .sort((a, b) => (a.lastName || "").localeCompare(b.lastName || ""));
---

<!doctype html>
<html lang="en">
    <head>
        <Layout title="About Us" />

        <style>
            .name {
                color: #828bda !important;
            }
        </style>
    </head>

    <body>
        <Nav />

        <!-- Hero Container -->
        <div
            class="container-fluid px-4 mt-4"
            style="background: linear-gradient(45deg,
      #ffffff10, #ffffff4d, #ffffff6a);"
        >
            <div class="row align-items-center">
                <!-- Left Column: Text Content -->
                <div
                    id="introMain"
                    class="col-lg-4 col-md-12 d-flex flex-column justify-content-center mb-4 mb-lg-0"
                >
                    <h1
                        id="title"
                        style="color: white; margin: 0; font-size: 5.2rem; font-family: 'Sansation', sans-serif !important; font-weight: 700 !important;"
                    >
                        ABOUT US
                    </h1>
                    <p
                        style="margin: 1rem 0; font-size: 1.4rem; font-family: 'Sansation', sans-serif; color: white; width: 95%;"
                    >
                        The foundation of Polaris Northern Stars and its key
                        members!
                    </p>
                    <ul class="nav" style="margin-top: 10px;">
                        <li
                            class="nav-item rounded-5"
                            style="background-color: var(--color-surface-alt);"
                        >
                            <a
                                class="text nav-link"
                                href="/history"
                                style="text-decoration: none;"
                                >Our Members Archive</a
                            >
                        </li>
                    </ul>
                </div>

                <!-- Right Column: Blue Box -->
                <div
                    id="col2Main"
                    class="col-lg-8 col-md-12 d-flex flex-column justify-content-center"
                    style="background-color: #0f2242b5; min-height: 600px; padding-top: 15px; padding-bottom: 15px;"
                >
                </div>
            </div>
        </div>

        <br />

        <div
            class="container-fluid"
            style="background-color: var(--color-surface-alt);"
        >
            <div class="row">
                <div class="col-12" style="padding: 50px 0 0 20px;">
                    <h1
                        style="color: white; font-family: 'Sansation', sans-serif; font-weight: 700;"
                    >
                        MEET OUR COMMUNITY
                    </h1>
                </div>
            </div>
            <div class="row">
                <div class="col-12" style="padding: 20px 20px 50px 20px;">
                    <!-- PRES AND VP -->
                    <div class="row">
                        {
                            execMembers.map((row) => (
                                <div
                                    class="text name col-lg-3 col-sm-12"
                                    style="margin: 2px 0 2px 0; color: var(--color-text-muted) !important;"
                                >
                                    <b>{ucwords(row.position)}: </b>
                                    {ucwords(row["firstName"])}{" "}
                                    {ucwords(row["lastName"])}
                                </div>
                            ))
                        }
                    </div>

                    <hr />

                    <!-- OTHER POSITIONS -->
                    <div class="row">
                        {
                            otherOfficers.map((row) => {
                                const formattedPosition =
                                    row.position.toLowerCase() === "pro"
                                        ? row.position.toUpperCase()
                                        : ucwords(row.position);

                                return (
                                    <div
                                        class="text name col-lg-3 col-sm-12"
                                        style="margin: 2px 0 2px 0; color: var(--color-text-muted) !important;"
                                    >
                                        <b>{formattedPosition}: </b>
                                        {ucwords(row["firstName"])}{" "}
                                        {ucwords(row["lastName"])}
                                    </div>
                                );
                            })
                        }
                    </div>

                    <hr />

                    <!-- LEADS -->
                    <div class="row">
                        {
                            leads.map((row) => (
                                <div
                                    class="text name col-lg-3 col-sm-12"
                                    style=" color: var(--color-text-muted) !important;"
                                >
                                    <b>{ucwords(row.position)}: </b>
                                    {ucwords(row["firstName"])}{" "}
                                    {ucwords(row["lastName"])}
                                </div>
                            ))
                        }
                    </div>

                    <!-- MEMBERS -->
                    <div class="row">
                        <h2
                            style="color:  color: var(--color-text-muted) !important;; font-family: 'Sansation', sans-serif; font-weight: 700; padding-top: 50px"
                        >
                            Members
                        </h2>
                        {
                            regularMembers.map((row) => (
                                <div
                                    class="text name col-lg-3 col-sm-12"
                                    style="margin: 2px 0 2px 0; color: var(--color-text-muted) !important;"
                                >
                                    {ucwords(row["lastName"])},{" "}
                                    {ucwords(row["firstName"])}
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
