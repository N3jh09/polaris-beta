---
import Layout from "../../components/global.astro";
import Nav from "../../components/navAdmin.astro";

// Define the TypeScript interface for your JSON structure
interface AuthorData {
    authors: string[];
}

// 1. Eagerly load all matching JSON files at build time
const jsonFiles = import.meta.glob<AuthorData>(
    "/src/data/authors/authors-*.json",
    {
        eager: true,
        import: "default",
    },
);

// 2. Set the target year
const currentYear = new Date().getFullYear();

// 3. Extract, sort, and find the most recent available year <= currentYear
const availableYears = Object.keys(jsonFiles)
    .map((path) => {
        const match = path.match(/authors-(\d{4})\.json$/);
        return match ? parseInt(match[1], 10) : null;
    })
    .filter((year): year is number => year !== null && year <= currentYear)
    .sort((a, b) => b - a); // Sort descending to get the newest year first

// 4. Retrieve authors from the target/fallback year
const targetYear = availableYears[0];
const selectedPath = `/src/data/authors/authors-${targetYear}.json`;
const authorData = targetYear ? jsonFiles[selectedPath] : null;
const authorsList = authorData?.authors ?? [];
---

<!doctype html>
<html>
    <head>
        <Layout title="Make a Blog" />
        <style is:global>
            /* Style the toolbar specifically */
            .ql-toolbar.ql-snow {
                background-color: #ffffff !important;
                border-bottom: 1px solid #ccc;
            }

            /* Style the text container */
            .ql-container.ql-snow {
                background-color: #ffffff !important;
            }
        </style>
    </head>
    <body style="background: white;">
        <Nav />
        <div class="container-fluid" style="margin-top: 50px;">
            <div class="row justify-content-center">
                <div class="col-lg-4 col-sm-12">
                    <h3 class="col-12">Post Details</h3>
                    <input
                        class="col-12"
                        type="text"
                        id="title"
                        placeholder="TITLE"
                        required
                    />
                    <select class="col-12" name="author" id="author" required>
                        <option
                            value=""
                            selected
                            disabled
                            hidden
                            style="color: grey;">Author</option
                        >
                        {
                            authorsList.length === 0 ? (
                                <option value="" disabled selected>
                                    No authors found
                                </option>
                            ) : (
                                authorsList.map((author) => (
                                    <option value={author}>{author}</option>
                                ))
                            )
                        }
                    </select>
                    <br /><br />
                    <label for="description">Post Description</label>
                    <textarea
                        class="col-12"
                        name="description"
                        id="description"
                        placeholder="A short summary of the post..."
                        rows="2"></textarea>
                    <label for="bannerPickBtn">Banner / Thumbnail Image</label>
                    <div class="banner-picker col-12">
                        <div class="banner-preview" id="bannerPreviewWrap">
                            <img id="bannerPreview" alt="" hidden />
                            <span id="bannerPreviewEmpty"
                                >No banner selected</span
                            >
                        </div>
                        <button
                            type="button"
                            id="bannerPickBtn"
                            class="banner-pick-btn">Choose from library</button
                        >
                        <button
                            type="button"
                            id="bannerClearBtn"
                            class="banner-clear-btn"
                            hidden>Remove</button
                        >
                    </div>
                    <input type="hidden" id="banner" />
                    <label for="keyCode">
                        <h5>Before you proceed...</h5>
                        Please enter the admin code. You will NOT be able to publish
                        this post without a correct and valid code.
                    </label>
                    <input
                        class="col-12"
                        type="text"
                        name="keyCode"
                        id="keyCode"
                        placeholder="**Insert Admin Key Here"
                        required
                    />
                    <br /><br /><br />
                </div>
                <div class="col-lg-6 col-sm-12">
                    <h3 class="col-12">Post Content</h3>
                    <div id="editor"></div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="editor-container">
                <button id="publish-btn" type="button">Publish Blog</button>
                <p id="status-msg"></p>
            </div>
        </div><script
            is:inline
            src="https://unpkg.com/turndown/dist/turndown.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"
        ></script>
        <script is:inline src="https://unpkg.com/turndown/dist/turndown.js"
        ></script>
        <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"
        ></script>
        <script>
            declare const TurndownService: any;
            import Quill from "quill";
            import "quill/dist/quill.snow.css";
            import {
                setupImageHandler,
                openImageLibrary,
            } from "../../scripts/imageLibrary";

            const toolbarOptions = [
                [
                    { header: 1 },
                    { header: 2 },
                    { header: 3 },
                    { header: 4 },
                    { header: 5 },
                    { header: 6 },
                ],
                [{ list: "ordered" }, { list: "bullet" }],
                ["bold", "italic", "blockquote", "link", "image"],
            ];

            const turndownService = new TurndownService();
            const quill = new Quill("#editor", {
                modules: {
                    toolbar: toolbarOptions,
                },
                theme: "snow",
            });

            const getAdminKey = () =>
                (document.getElementById("keyCode") as HTMLInputElement).value;

            // Route the toolbar's image button through the GitHub-backed
            // image library instead of Quill's default URL prompt.
            setupImageHandler(quill, getAdminKey);

            // Banner/thumbnail picker — same library, but just sets a field
            // instead of inserting into the post body.
            const bannerInput = document.getElementById(
                "banner",
            ) as HTMLInputElement;
            const bannerPreview = document.getElementById(
                "bannerPreview",
            ) as HTMLImageElement;
            const bannerPreviewEmpty = document.getElementById(
                "bannerPreviewEmpty",
            ) as HTMLSpanElement;
            const bannerClearBtn = document.getElementById(
                "bannerClearBtn",
            ) as HTMLButtonElement;

            function setBanner(url: string) {
                bannerInput.value = url;
                bannerPreview.src = url;
                bannerPreview.hidden = false;
                bannerPreviewEmpty.hidden = true;
                bannerClearBtn.hidden = false;
            }

            document
                .getElementById("bannerPickBtn")
                ?.addEventListener("click", () => {
                    openImageLibrary({
                        getKey: getAdminKey,
                        onPick: setBanner,
                    });
                });

            bannerClearBtn?.addEventListener("click", () => {
                bannerInput.value = "";
                bannerPreview.hidden = true;
                bannerPreviewEmpty.hidden = false;
                bannerClearBtn.hidden = true;
            });

            const publishBtn = document.getElementById("publish-btn");
            const statusMsg = document.getElementById("status-msg");

            // Slug generator helper
            function generateSlug(title: string, dateStr: string): string {
                const cleanTitle = title
                    .toLowerCase()
                    .trim()
                    .replace(/[^\w\s-]/g, "") // Remove special characters
                    .replace(/\s+/g, "-"); // Replace spaces with '-'

                return `${cleanTitle}-${dateStr}`;
            }

            publishBtn?.addEventListener("click", async () => {
                if (!statusMsg) return;

                const title = (
                    document.getElementById("title") as HTMLInputElement
                ).value;
                const author = (
                    document.getElementById("author") as HTMLInputElement
                ).value;
                const description = (
                    document.getElementById(
                        "description",
                    ) as HTMLTextAreaElement
                ).value;

                // --- NEW: Grab the key from the keyCode input element ---
                const keyCode = (
                    document.getElementById("keyCode") as HTMLInputElement
                ).value;

                if (!title || !author) {
                    statusMsg.innerText =
                        "Please provide both a Title and an Author.";
                    return;
                }

                if (!keyCode) {
                    statusMsg.innerText = "Please provide the admin key.";
                    return;
                }

                statusMsg.innerText = "Publishing...";

                // 1. Auto-generate Date (YYYY-MM-DD)
                const now = new Date();
                const pubDate = now.toISOString().split("T")[0];

                // 2. Auto-generate Slug (title-formatted-YYYY-MM-DD)
                const slug = generateSlug(title, pubDate);

                // 3. Convert Quill HTML to Markdown
                const bodyMarkdown = turndownService.turndown(
                    quill.root.innerHTML,
                );

                // 4. Construct Markdown with Frontmatter YAML
                const bannerLine = bannerInput.value
                    ? `banner: "${bannerInput.value}"\n`
                    : "";

                const fullMarkdown = `---
title: "${title.replace(/"/g, '\\"')}"
author: "${author.replace(/"/g, '\\"')}"
pubDate: ${pubDate}
slug: "${slug}"
desc: "${description.replace(/"/g, '\\"')}"
${bannerLine}---

${bodyMarkdown}`;

                // 5. Send payload to API endpoint including the key
                try {
                    const response = await fetch("/api/save-github", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            slug,
                            content: fullMarkdown,
                            type: "blog", // Specifies the destination subfolder
                            key: keyCode, // Pass the key to match backend verification
                        }),
                    });

                    const data = await response.json();

                    if (response.ok) {
                        statusMsg.innerText = `Published successfully! File: ${slug}.md`;
                    } else {
                        statusMsg.innerText = `Error: ${data.message}`;
                    }
                } catch (err) {
                    statusMsg.innerText =
                        "Network error while attempting to publish.";
                }
            });
        </script>
    </body>
</html>

<style>
    .editor-container {
        max-width: 700px;
        margin: 2rem auto;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    input,
    textarea,
    select {
        padding: 0.6rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
    }
    #editor {
        height: 300px;
        background: #fff;
    }
    .banner-picker {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }
    .banner-preview {
        width: 140px;
        height: 80px;
        border: 1px dashed #ccc;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #fafafa;
        font-size: 0.75rem;
        color: #999;
        text-align: center;
        padding: 4px;
    }
    .banner-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .banner-pick-btn,
    .banner-clear-btn {
        padding: 0.5rem 0.8rem;
        font-size: 0.85rem;
        width: auto;
    }
    .banner-clear-btn {
        background-color: #b3261e;
    }
    button {
        padding: 0.8rem;
        background-color: #000957;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }
</style>
