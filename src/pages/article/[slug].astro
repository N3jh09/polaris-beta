---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/blogLayout.astro";

export const prerender = true; // <--- Critical for Cloudflare Workers when using getStaticPaths

export async function getStaticPaths() {
    const posts = await getCollection("article");
    return posts.map((post: CollectionEntry<"article">) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"article">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
    <div class="row">
        <div class="col-lg-9 col-sm-12">
            <a
                href="/articles"
                style="text-decoration: none; color: var(--color-text-muted-1);"
                >Go back</a
            >
            <br />
            <h6 style="color: var(--color-surface-alt-1);">
                <b>POLARIS Articles</b>
            </h6>

            {
                post.data.banner && (
                    <img
                        src={post.data.banner}
                        alt=""
                        class="col-12 post-banner"
                    />
                )
            }
            <h1 class="col-lg-8 col-sm-12"><b>{post.data.title}</b></h1>
            <p style="color: var(--color-text);">
                {post.data.desc}
            </p>
            <p style="color: var(--color-text-muted-1);" class="dateAuth">
                | uploaded on {
                    new Date(post.data.pubDate)
                        .toLocaleString("en-US", {
                            month: "long",
                            day: "numeric",
                            year: "numeric",
                        })
                        .toLocaleLowerCase()
                } ・ by {post.data.author.toLowerCase()}
            </p>
            <hr style="color: var(--color-text-muted-1);" />
            <div class="col-lg-9 col-sm-12 post-content">
                <Content />
            </div>
        </div>
        <div class="col-lg-3 col-sm-12" style="padding-top: 50px;">
            <div
                style="border: 2px solid lightgrey; padding: 15px; border-radius: 5px; background-color: var(--color-surface-alt);"
            >
                <p
                    style="padding-bottom: 0; color: var(--color-text-inverted);"
                >
                    search more articles
                </p>
                <form action="/article/search" method="get">
                    <input
                        class="col-12 filterItem"
                        type="text"
                        id="search"
                        name="q"
                        placeholder="search articles"
                    />
                    <input
                        class="col-12 filterItem"
                        type="text"
                        id="author"
                        name="author"
                        placeholder="search for author"
                    />
                    <input
                        class="col-12 filterItem"
                        type="text"
                        id="tags"
                        name="tags"
                        placeholder="search tags (comma separated)"
                    />
                    <br />
                    <br />
                    <button class="col-12" id="submitSearch"
                        >submit search</button
                    >
                </form>
            </div>
            <hr style="color: var(--color-text-muted-1);" />
            <p style="color: var(--color-text-muted-1);">article tags</p>
            {
                post.data.tags && post.data.tags.length > 0 && (
                    <div class="tag-row">
                        {post.data.tags.map((tag) => (
                            <a href={`/article/tag/${tag}/1`} class="tag-pill">
                                {tag}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</BaseLayout>

<style>
    .dateAuth {
        font-size: 14px;
    }

    .post-banner {
        width: 100%;
        max-height: 380px;
        object-fit: cover;
        border-radius: 8px;
        margin: 12px 0;
    }
    .filterItem {
        padding: 10px;
        border-radius: 5px;
        border: 1px solid var(--color-border);
        margin-bottom: 5px;
        background-color: var(--color-surface-alt-1);
        color: white;
    }

    .filterItem::placeholder {
        color: var(--color-text-muted);
    }

    .filterItem:focus {
        border: 2px solid var(--color-focus-ring);
        outline: none;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .tag-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        background-color: var(--color-surface-alt);
        color: var(--color-text-inverted);
        font-size: 0.85rem;
        text-decoration: none;
        border: 1px solid var(--color-surface-alt-1);
    }

    .tag-pill:hover {
        border: 1px solid var(--color-focus-ring);
    }

    .headerTitle {
        padding-top: 50px !important;
    }

    .headerText {
        font-size: 20px !important;
    }

    #submitSearch {
        padding: 10px;
        background-color: var(--color-accent);
        color: var(--color-accent-text);
        border: none;
        border-radius: 5px;
    }

    #submitSearch:hover {
        background-color: #da8d18;
    }

    @media only screen and (max-width: 800px) {
        .dateAuth {
            font-size: 12px;
        }
    }
</style>
