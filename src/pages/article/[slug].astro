---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/blogLayout.astro";

export const prerender = true; // <--- Critical for Cloudflare Workers when using getStaticPaths

export async function getStaticPaths() {
    const posts = await getCollection("article");
    return posts.map((post: CollectionEntry<"article">) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"article">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
    <a href="/blogs" style="text-decoration: none; color:gray;">Go back</a>
    <br />
    <h6 style="color: #000957;"><b>POLARIS Articles</b></h6>
    <h1 class="col-lg-8 col-sm-12"><b>{post.data.title}</b></h1>
    <p style="color: grey;">
        | uploaded on {
            new Date(post.data.pubDate)
                .toLocaleString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                })
                .toLocaleLowerCase()
        } ・ written by {post.data.author.toLowerCase()}
    </p>
    <br />
    <div class="col-lg-6 col-sm-12">
        <Content />
    </div>
</BaseLayout>
