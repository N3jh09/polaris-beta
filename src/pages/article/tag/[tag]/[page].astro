---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

import Layout from "../../../../components/global.astro";
import Nav from "../../../../components/nav.astro";
import Little from "../../../../components/blogLittle.astro";

// Static-friendly: build paginated pages per tag that actually exists in
// the content, discovered at build time. No fixed tag list anywhere.
export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
    const posts = await getCollection("article");

    // Collect every distinct tag across all posts
    const tagSet = new Set<string>();
    for (const post of posts) {
        for (const tag of post.data.tags ?? []) {
            tagSet.add(tag);
        }
    }

    return Array.from(tagSet).flatMap((tag) => {
        const matching = posts
            .filter((p) => (p.data.tags ?? []).includes(tag))
            .sort(
                (a, b) =>
                    new Date(b.data.pubDate).getTime() -
                    new Date(a.data.pubDate).getTime(),
            );

        return paginate(matching, {
            params: { tag },
            pageSize: 5,
        });
    });
}) satisfies GetStaticPaths;

interface Props {
    page: {
        data: CollectionEntry<"article">[];
        total: number;
        currentPage: number;
        lastPage: number;
        url: { prev?: string; next?: string };
    };
}

const { tag } = Astro.params;
const { page } = Astro.props as Props;
---

<!doctype html>
<html>
    <head>
        <Layout title={`#${tag} - Articles - Page ${page.currentPage}`} />
    </head>
    <body>
        <Nav />
        <div class="container-fluid">
            <div
                class="row"
                style="background-color: white; padding-bottom: 30px;"
            >
                <div class="col-12" style="padding: 50px 20px 20px 20px;">
                    <div class="col-12 headerTitle">
                        <h6 style="color: var(--color-surface-alt-1);">
                            <b>POLARIS Articles</b>
                        </h6>
                        <h1><b>#{tag}</b></h1>
                        <p
                            class="headerText col-lg-9 col-sm-12"
                            style="color: var(--color-text-muted-1);"
                        >
                            {page.total} post{page.total === 1 ? "" : "s"} tagged
                            "{tag}".
                        </p>
                        <a
                            href="/article/1"
                            style="color: var(--color-text-muted-1); text-decoration: underline;"
                            >&larr; Back to all articles</a
                        >
                    </div>

                    {
                        page.data.map((i) => (
                            <Little
                                banner={i.data.banner}
                                href={`/article/${i.id}`}
                            >
                                <a
                                    class="col-12"
                                    href={`/article/${i.id}`}
                                    style="color: var(--color-text); text-decoration: none;"
                                >
                                    <h3>{i.data.title}</h3>
                                </a>
                                <div
                                    class="col-12"
                                    style="padding-bottom: 10px; margin-top: -5px;"
                                >
                                    <p style="color: var(--color-text-muted-1); margin-bottom: 0;">
                                        by {i.data.author}・
                                        {new Date(
                                            i.data.pubDate,
                                        ).toLocaleString("en-US", {
                                            month: "2-digit",
                                            day: "2-digit",
                                            year: "numeric",
                                        })}
                                    </p>
                                    {i.data.desc}
                                    {i.data.tags && i.data.tags.length > 0 && (
                                        <div class="tag-row">
                                            {i.data.tags.map((t) => (
                                                <a
                                                    href={`/article/tag/${t}/1`}
                                                    class="tag-pill"
                                                >
                                                    {t}
                                                </a>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </Little>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="container-fluid sticky-bottom">
            <div
                class="row"
                style="background-color: var(--color-surface-alt);"
            >
                <nav class="pagination-controls">
                    {
                        page.url.prev ? (
                            <a href={page.url.prev} class="page-btn">
                                &larr; Previous
                            </a>
                        ) : (
                            <span class="page-btn disabled">
                                &larr; Previous
                            </span>
                        )
                    }
                    <span class="page-indicator"
                        >Page {page.currentPage} of {page.lastPage}</span
                    >
                    {
                        page.url.next ? (
                            <a href={page.url.next} class="page-btn">
                                Next &rarr;
                            </a>
                        ) : (
                            <span class="page-btn disabled">Next &rarr;</span>
                        )
                    }
                </nav>
            </div>
        </div>
    </body>
</html>

<style>
    .pagination-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 600px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    .pagination-controls .page-btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.2s ease;
    }

    .pagination-controls a.page-btn:hover {
        background-color: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    .pagination-controls .page-btn.disabled {
        opacity: 0.35;
        cursor: not-allowed;
        border-color: transparent;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .pagination-controls .page-indicator {
        color: #e2e8f0;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .tag-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        background-color: var(--color-surface-alt);
        color: var(--color-text-inverted);
        font-size: 0.85rem;
        text-decoration: none;
        border: 1px solid var(--color-surface-alt-1);
    }

    .tag-pill:hover {
        border: 1px solid var(--color-focus-ring);
    }
</style>
