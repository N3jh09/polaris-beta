---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

import Layout from "../../components/global.astro";
import Nav from "../../components/nav.astro";
import Little from "../../components/blogLittle.astro";

// Forces Astro to use getStaticPaths even in SSR mode
export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
    const posts = (await getCollection("article")).sort(
        (a, b) =>
            new Date(b.data.pubDate).getTime() -
            new Date(a.data.pubDate).getTime(),
    );

    return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<!doctype html>
<html>
    <head>
        <Layout title={`Blogs and News - Page ${page.currentPage}`} />
    </head>
    <body>
        <Nav />
        <div class="container-fluid">
            {
                page.data.map((i) => (
                    <Little>
                        <a href={`/article/${i.id}`}>
                            <h4>{i.data.title}</h4>
                        </a>
                        {i.data.desc}
                        <p style="color: #6b6b6b">
                            {new Date(i.data.pubDate).toLocaleString("en-US", {
                                month: "long",
                                day: "numeric",
                                year: "numeric",
                            })}
                        </p>
                    </Little>
                ))
            }
        </div>

        <!-- Pagination Controls -->
        <div class="container-fluid">
            <div class="row" style="background-color: #000957;">
                <nav class="pagination-controls">
                    {
                        page.url.prev ? (
                            <a href={page.url.prev} class="page-btn">
                                &larr; Previous
                            </a>
                        ) : (
                            <span class="page-btn disabled">
                                &larr; Previous
                            </span>
                        )
                    }
                    <span class="page-indicator"
                        >Page {page.currentPage} of {page.lastPage}</span
                    >
                    {
                        page.url.next ? (
                            <a href={page.url.next} class="page-btn">
                                Next &rarr;
                            </a>
                        ) : (
                            <span class="page-btn disabled">Next &rarr;</span>
                        )
                    }
                </nav>
            </div>
        </div>
    </body>
</html>

<style>
    .pagination-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 600px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Target both links and spans using the class */
    .pagination-controls .page-btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.2s ease;
    }

    /* Interactive hover state for active page links */
    .pagination-controls a.page-btn:hover {
        background-color: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    /* Muted styling for inactive buttons */
    .pagination-controls .page-btn.disabled {
        opacity: 0.35;
        cursor: not-allowed;
        border-color: transparent;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .pagination-controls .page-indicator {
        color: #e2e8f0;
        font-size: 0.95rem;
        font-weight: 500;
    }
</style>
