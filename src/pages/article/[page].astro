---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

import Layout from "../../components/global.astro";
import Nav from "../../components/nav.astro";
import Little from "../../components/blogLittle.astro";

// Forces Astro to use getStaticPaths even in SSR mode
export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
    const posts = (await getCollection("article")).sort(
        (a, b) =>
            new Date(b.data.pubDate).getTime() -
            new Date(a.data.pubDate).getTime(),
    );

    return paginate(posts, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Tag cloud scoped to just the posts shown on THIS page (not site-wide)
const pageTags = Array.from(
    new Set(page.data.flatMap((i) => i.data.tags ?? [])),
).sort();
---

<!doctype html>
<html>
    <head>
        <Layout title={`Blogs and News - Page ${page.currentPage}`} />
    </head>
    <body>
        <Nav />
        <div class="container-fluid">
            <div
                class="row"
                style="background-color: white; padding-bottom: 30px;"
            >
                <div
                    class="col-lg-3 col-sm-12"
                    style="padding: 50px 20px 20px 20px;"
                >
                    <div
                        style="border: 2px solid lightgrey; padding: 15px; border-radius: 5px;"
                    >
                        <h3 style="padding-bottom: 0; padding-left: 5px;">
                            Search Articles
                        </h3>
                        <form action="/article/search" method="get">
                            <input
                                class="col-12 filterItem"
                                type="text"
                                id="search"
                                name="q"
                                placeholder="search blog titles"
                            />
                            <input
                                class="col-12 filterItem"
                                type="text"
                                id="author"
                                name="author"
                                placeholder="search for authors"
                            />
                            <input
                                class="col-12 filterItem"
                                type="text"
                                id="tags"
                                name="tags"
                                placeholder="search tags (comma separated)"
                            />
                            <br />
                            <br />
                            <button class="col-12" id="submitSearch"
                                >submit search</button
                            >
                        </form>
                    </div>
                    <hr />
                    {
                        pageTags.length > 0 && (
                            <div style="margin-top: 20px;">
                                <h5 style="padding-bottom: 0; padding-left: 5px;">
                                    view articles with similar tags
                                </h5>
                                <div class="tag-row">
                                    {pageTags.map((t) => (
                                        <a
                                            href={`/article/tag/${t}/1`}
                                            class="tag-pill"
                                        >
                                            {t}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )
                    }
                </div>
                <div class="col-lg-9 col-sm-12">
                    <div class="col-12 headerTitle">
                        <h6 style="color: #000957;"><b>POLARIS Articles</b></h6>
                        <h1><b>ARTICLES</b></h1>
                        <p class="headerText col-lg-9 col-sm-12">
                            Interested in astronomy and Space? Read our
                            community written articles. Scroll chronologically
                            or use the search feature to filter through post
                            titles and authors.
                        </p>
                    </div>
                    {
                        page.data.map((i) => (
                            <Little>
                                <a
                                    class="col-12"
                                    href={`/article/${i.id}`}
                                    style="color: #000957; text-decoration: none;"
                                >
                                    <h3>{i.data.title}</h3>
                                </a>
                                <div
                                    class="col-lg-10 col-sm-12"
                                    style="padding-bottom: 10px; margin-top: -5px;"
                                >
                                    <p style="color: #adadad; margin-bottom: 0;">
                                        by {i.data.author}・
                                        {new Date(
                                            i.data.pubDate,
                                        ).toLocaleString("en-US", {
                                            month: "2-digit",
                                            day: "2-digit",
                                            year: "numeric",
                                        })}
                                    </p>
                                    {i.data.desc}
                                    {i.data.tags && i.data.tags.length > 0 && (
                                        <div class="tag-row">
                                            {i.data.tags.map((t) => (
                                                <a
                                                    href={`/article/tag/${t}/1`}
                                                    class="tag-pill"
                                                >
                                                    {t}
                                                </a>
                                            ))}
                                        </div>
                                    )}
                                </div>

                                <div class="col-lg-2 col-sm-12 redPBtn">
                                    <a
                                        href={`/article/${i.id}`}
                                        style="padding: 10px; background-color: #000957; color: white; text-decoration: none; border-radius: 5px;"
                                    >
                                        Read Post
                                    </a>
                                </div>
                            </Little>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="container-fluid">
            <div class="row" style="background-color: #000957;">
                <nav class="pagination-controls">
                    {
                        page.url.prev ? (
                            <a href={page.url.prev} class="page-btn">
                                &larr; Previous
                            </a>
                        ) : (
                            <span class="page-btn disabled">
                                &larr; Previous
                            </span>
                        )
                    }
                    <span class="page-indicator"
                        >Page {page.currentPage} of {page.lastPage}</span
                    >
                    {
                        page.url.next ? (
                            <a href={page.url.next} class="page-btn">
                                Next &rarr;
                            </a>
                        ) : (
                            <span class="page-btn disabled">Next &rarr;</span>
                        )
                    }
                </nav>
            </div>
        </div>
    </body>
</html>

<style is:global>
    .pagination-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 600px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Target both links and spans using the class */
    .pagination-controls .page-btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.2s ease;
    }

    /* Interactive hover state for active page links */
    .pagination-controls a.page-btn:hover {
        background-color: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    /* Muted styling for inactive buttons */
    .pagination-controls .page-btn.disabled {
        opacity: 0.35;
        cursor: not-allowed;
        border-color: transparent;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .pagination-controls .page-indicator {
        color: #e2e8f0;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .filterItem {
        padding: 10px;
        border-radius: 50px;
        border: 2px solid grey;
        margin-bottom: 5px;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .tag-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        background-color: #eef0fa;
        color: #000957;
        font-size: 0.85rem;
        text-decoration: none;
    }

    .tag-pill:hover {
        background-color: #dde1f5;
    }

    .headerTitle {
        padding-top: 50px !important;
    }

    .headerText {
        font-size: 20px !important;
    }

    #submitSearch {
        padding: 10px;
        background-color: #000957;
        color: white;
        border: none;
        border-radius: 5px;
    }

    @media only screen and (max-width: 800px) {
        .headerTitle {
            padding-top: 10px !important;
            padding-left: 10px;
        }

        .headerText {
            font-size: 16px !important;
        }

        .redPBtn {
            display: flex;
            justify-content: flex-end;
            font-size: 14px;
        }
    }
</style>
