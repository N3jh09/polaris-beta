---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

import Layout from "../../components/global.astro";
import Nav from "../../components/nav.astro";
import Little from "../../components/blogLittle.astro";

// Forces Astro to use getStaticPaths even in SSR mode
export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
    const posts = (await getCollection("blog")).sort(
        (a, b) =>
            new Date(b.data.pubDate).getTime() -
            new Date(a.data.pubDate).getTime(),
    );

    return paginate(posts, { pageSize: 5 });
}) satisfies GetStaticPaths;

// AUTHORS
// Define the TypeScript interface for your JSON structure
interface AuthorData {
    authors: string[];
}

// 1. Eagerly load all matching JSON files at build time
const jsonFiles = import.meta.glob<AuthorData>(
    "/src/data/authors/authors-*.json",
    {
        eager: true,
        import: "default",
    },
);

// 2. Set the target year
const currentYear = new Date().getFullYear();

// 3. Extract, sort, and find the most recent available year <= currentYear
const availableYears = Object.keys(jsonFiles)
    .map((path) => {
        const match = path.match(/authors-(\d{4})\.json$/);
        return match ? parseInt(match[1], 10) : null;
    })
    .filter((year): year is number => year !== null && year <= currentYear)
    .sort((a, b) => b - a); // Sort descending to get the newest year first

// 4. Retrieve authors from the target/fallback year
const targetYear = availableYears[0];
const selectedPath = `/src/data/authors/authors-${targetYear}.json`;
const authorData = targetYear ? jsonFiles[selectedPath] : null;
const authorsList = authorData?.authors ?? [];

const { page } = Astro.props;
---

<!doctype html>
<html>
    <head>
        <Layout title={`Blogs and News - Page ${page.currentPage}`} />
    </head>
    <body>
        <Nav />
        <div class="container-fluid">
            <div class="row" style="background-color: white;">
                <div
                    class="col-lg-3 col-sm-12"
                    style="padding: 50px 20px 20px 20px; background-color: var(--color-surface-alt);"
                >
                    <h3
                        style="padding-bottom: 0; padding-left: 5px; color: var(--color-text-inverted);"
                    >
                        Search Blogs
                    </h3>
                    <form action="/blog/search" method="get">
                        <input
                            class="col-12 filterItem"
                            type="text"
                            id="search"
                            name="q"
                            placeholder="search blog titles"
                        />
                        <select
                            class="col-12 filterItem"
                            id="author"
                            name="author"
                        >
                            <option value="" selected style="color: grey;"
                                >search for author</option
                            >
                            {
                                authorsList.length === 0 ? (
                                    <option value="" disabled selected>
                                        No authors found
                                    </option>
                                ) : (
                                    authorsList.map((author) => (
                                        <option value={author}>{author}</option>
                                    ))
                                )
                            }
                        </select>
                        <br />
                        <br />
                        <button class="col-12" id="submitSearch"
                            >submit search</button
                        >
                    </form>
                </div>
                <div
                    class="col-lg-9 col-sm-12 contentBody"
                    style="padding: 0 15px 30px 30px;"
                >
                    <div class="col-12 headerTitle">
                        <h6 style="color: var(--color-accent);">
                            <b>POLARIS Blogs</b>
                        </h6>
                        <h1><b>BLOGS AND NEWS</b></h1>
                        <p
                            class="headerText col-lg-9 col-sm-12"
                            style="color: var(--color-text-muted-1);"
                        >
                            Read our latest events and activities hosted by our
                            community. Or scroll through past news, updates, and
                            official posts. Scroll chronologically or use the
                            search feature to filter through post titles and
                            authors.
                        </p>
                    </div>
                    {
                        page.data.map((i) => (
                            <Little
                                banner={i.data.banner}
                                href={`/blog/${i.id}`}
                            >
                                <a
                                    class="col-12"
                                    href={`/blog/${i.id}`}
                                    style="color: var(--color-text); text-decoration: none;"
                                >
                                    <h3>{i.data.title}</h3>
                                </a>
                                <div
                                    class="col-12"
                                    style="padding-bottom: 10px; margin-top: -5px;"
                                >
                                    <p style="color: var(--color-text-muted-1); margin-bottom: 0;">
                                        by {i.data.author}・
                                        {new Date(
                                            i.data.pubDate,
                                        ).toLocaleString("en-US", {
                                            month: "2-digit",
                                            day: "2-digit",
                                            year: "numeric",
                                        })}
                                    </p>
                                    {i.data.desc}
                                </div>
                            </Little>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="container-fluid sticky-bottom">
            <div
                class="row"
                style="background-color: var(--color-bg-inverted);"
            >
                <nav class="pagination-controls">
                    {
                        page.url.prev ? (
                            <a href={page.url.prev} class="page-btn">
                                &larr; Previous
                            </a>
                        ) : (
                            <span class="page-btn disabled">
                                &larr; Previous
                            </span>
                        )
                    }
                    <span class="page-indicator"
                        >Page {page.currentPage} of {page.lastPage}</span
                    >
                    {
                        page.url.next ? (
                            <a href={page.url.next} class="page-btn">
                                Next &rarr;
                            </a>
                        ) : (
                            <span class="page-btn disabled">Next &rarr;</span>
                        )
                    }
                </nav>
            </div>
        </div>
    </body>
</html>

<style is:global>
    .pagination-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 600px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Target both links and spans using the class */
    .pagination-controls .page-btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.2s ease;
    }

    /* Interactive hover state for active page links */
    .pagination-controls a.page-btn:hover {
        background-color: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    /* Muted styling for inactive buttons */
    .pagination-controls .page-btn.disabled {
        opacity: 0.35;
        cursor: not-allowed;
        border-color: transparent;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .pagination-controls .page-indicator {
        color: #e2e8f0;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .filterItem {
        padding: 10px;
        border-radius: 5px;
        border: 1px solid var(--color-border);
        margin-bottom: 5px;
        background-color: var(--color-surface-alt-1);
        color: white;
    }

    .filterItem::placeholder,
    #author:has(option[value=""]:checked) {
        color: var(--color-text-muted);
    }

    .filterItem:focus {
        border: 2px solid var(--color-focus-ring);
        outline: none;
    }

    .headerTitle {
        padding-top: 50px !important;
    }

    .headerText {
        font-size: 20px !important;
    }

    #submitSearch {
        padding: 10px;
        background-color: var(--color-accent);
        color: var(--color-accent-text);
        border: none;
        border-radius: 5px;
    }

    #submitSearch:hover {
        background-color: #da8d18;
    }

    @media only screen and (max-width: 800px) {
        .headerTitle {
            padding-top: 10px !important;
            padding-left: 10px;
        }

        .headerText {
            font-size: 16px !important;
        }

        .contentBody {
            padding: 50px 10px 30px 10px !important;
        }
    }
</style>
