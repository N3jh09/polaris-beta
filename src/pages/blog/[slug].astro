---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/blogLayout.astro";

export const prerender = true; // <--- Critical for Cloudflare Workers when using getStaticPaths

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post: CollectionEntry<"blog">) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
}

// AUTHORS
// Define the TypeScript interface for your JSON structure
interface AuthorData {
    authors: string[];
}

// 1. Eagerly load all matching JSON files at build time
const jsonFiles = import.meta.glob<AuthorData>(
    "/src/data/authors/authors-*.json",
    {
        eager: true,
        import: "default",
    },
);

// 2. Set the target year
const currentYear = new Date().getFullYear();

// 3. Extract, sort, and find the most recent available year <= currentYear
const availableYears = Object.keys(jsonFiles)
    .map((path) => {
        const match = path.match(/authors-(\d{4})\.json$/);
        return match ? parseInt(match[1], 10) : null;
    })
    .filter((year): year is number => year !== null && year <= currentYear)
    .sort((a, b) => b - a); // Sort descending to get the newest year first

// 4. Retrieve authors from the target/fallback year
const targetYear = availableYears[0];
const selectedPath = `/src/data/authors/authors-${targetYear}.json`;
const authorData = targetYear ? jsonFiles[selectedPath] : null;
const authorsList = authorData?.authors ?? [];

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
    <div class="row">
        <div class="col-lg-9 col-sm-12">
            <a
                href="/blogs"
                style="text-decoration: none; color: var(--color-text-muted-1);"
                >Go back</a
            >
            <br />
            <h6 style="color: var(--color-surface-alt-1);">
                <b>POLARIS Blogs</b>
            </h6>
            <h1 class="col-lg-8 col-sm-12"><b>{post.data.title}</b></h1>
            <p style="color: var(--color-text-muted-1);">
                | uploaded on {
                    new Date(post.data.pubDate)
                        .toLocaleString("en-US", {
                            month: "long",
                            day: "numeric",
                            year: "numeric",
                        })
                        .toLocaleLowerCase()
                } ・ written by {post.data.author.toLowerCase()}
            </p>
            {
                post.data.banner && (
                    <img
                        src={post.data.banner}
                        alt=""
                        class="col-12 post-banner"
                    />
                )
            }
            <br />
            <div class="col-lg-9 col-sm-12 post-content">
                <Content />
            </div>
        </div>
        <div class="col-lg-3 col-sm-12" style="padding-top: 50px;">
            <div
                style="border: 2px solid var(--color-surface-alt-1); padding: 15px; border-radius: 5px; background-color: var(--color-surface-alt);"
            >
                <p
                    style="padding-bottom: 0; color: var(--color-text-inverted);"
                >
                    search more blogs and news
                </p>
                <form action="/blog/search" method="get">
                    <input
                        class="col-12 filterItem"
                        type="text"
                        id="search"
                        name="q"
                        placeholder="search blogs"
                    />
                    <select class="col-12 filterItem" id="author" name="author">
                        <option value="" selected style="color: grey;"
                            >search for author</option
                        >
                        {
                            authorsList.length === 0 ? (
                                <option value="" disabled selected>
                                    No authors found
                                </option>
                            ) : (
                                authorsList.map((author) => (
                                    <option value={author}>{author}</option>
                                ))
                            )
                        }
                    </select>
                    <br />
                    <br />
                    <button class="col-12" id="submitSearch"
                        >submit search</button
                    >
                </form>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .post-banner {
        width: 100%;
        max-height: 380px;
        object-fit: cover;
        border-radius: 8px;
        margin: 12px 0;
    }
    .filterItem {
        padding: 10px;
        border-radius: 5px;
        border: 1px solid var(--color-border);
        margin-bottom: 5px;
        background-color: var(--color-surface-alt-1);
        color: white;
    }

    .filterItem::placeholder,
    #author:has(option[value=""]:checked) {
        color: var(--color-text-muted);
    }

    .filterItem:focus {
        border: 2px solid var(--color-focus-ring);
        outline: none;
    }

    #submitSearch {
        padding: 10px;
        background-color: var(--color-accent);
        color: var(--color-accent-text);
        border: none;
        border-radius: 5px;
    }

    #submitSearch:hover {
        background-color: #da8d18;
    }
</style>
