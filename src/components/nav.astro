---
const currentPath = Astro.url.pathname;
import "../assets/main.css";
---

<nav
    class="navbar navbar-expand-sm"
    style="background-color: var(--color-bg-inverted);"
>
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <b style="color: var(--color-accent);">・</b>
            POLARIS
        </a>
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navItems"
        >
            <span class="navbar-toggler-icon navbar-dark" style="color: white;"
            ></span>
        </button>
        <div class="collapse navbar-collapse" id="navItems">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="/about text nav-link" href="/about">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="/blogs text nav-link" href="/blogs"
                        >Blogs and News</a
                    >
                </li>
                <li class="nav-item">
                    <a class="/articles text nav-link" href="/articles"
                        >Articles</a
                    >
                </li>
            </ul>
        </div>
    </div>
</nav>

<style>
    nav a {
        color: white; /* Default color for other links */
        text-decoration: none;
    }

    /* The logic applies this class to turn the text yellow */
    nav a.active {
        color: #ebe645 !important;
    }
</style>
