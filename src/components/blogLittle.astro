---
interface Props {
    banner?: string;
}
const { banner } = Astro.props;
---

<div>
    <div class="card newsMain">
        {
            banner && (
                <div class="newsThumb">
                    <img src={banner} alt="" loading="lazy" />
                </div>
            )
        }
        <div class="card-body row"><slot /></div>
    </div>
</div>

<style>
    .newsThumb {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: 6px 6px 0 0;
    }
    .newsThumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
