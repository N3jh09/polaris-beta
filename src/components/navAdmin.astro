---
const currentPath = Astro.url.pathname;
import "../assets/main.css";
---

<nav class="navbar navbar-expand-sm" style="background-color: #000957;">
    <div class="container-fluid" style="justify-content: start;">
        <a
            style="cursor: default; color: white; font-family: 'Sansation', sans-serif;"
            class="navbar-brand"
            href="#">POLARIS Admin</a
        >
        <!-- Links -->
        <ul class="navbar-nav">
            <li class="nav-item">
                <a
                    class={currentPath === "/"
                        ? "active text nav-link"
                        : "text nav-link"}
                    href="/">Home</a
                >
            </li>
            <li class="nav-item">
                <a
                    class={currentPath === "/about"
                        ? "active text nav-link"
                        : "text nav-link"}
                    href="/about">About Us</a
                >
            </li>
            <li class="nav-item">
                <a
                    class={currentPath === "/blogs"
                        ? "active text nav-link"
                        : "text nav-link"}
                    href="/blogs">Blogs and News</a
                >
            </li>
            <li class="nav-item">
                <a
                    class={currentPath === "/articles"
                        ? "active text nav-link"
                        : "text nav-link"}
                    href="/articles">Articles</a
                >
            </li>
        </ul>
    </div>
</nav>

<style>
    nav a {
        color: white; /* Default color for other links */
        text-decoration: none;
    }

    /* The logic applies this class to turn the text yellow */
    nav a.active {
        color: #ebe645 !important;
    }
</style>
